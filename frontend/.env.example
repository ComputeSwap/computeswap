# Server side (never sent to the browser).

# Postgres for the indexed history. Vercel's Neon integration sets DATABASE_URL (POSTGRES_URL also works).
# Leave unset locally: the app then uses an embedded PGlite database in frontend/.pglite/.
DATABASE_URL=

# RPC the indexer and the shared state snapshot read through (default: "rpc" in deployments.json).
# A separate key from the browser's lets you cap each one independently.
INDEXER_RPC_URL=

# Blocks per eth_getLogs call (Alchemy free tier: 10; public Unichain RPC: up to 10000).
INDEXER_LOG_CHUNK=10
# How long one sync call may run before it stops and leaves the rest for the next call, in ms.
INDEXER_TIME_BUDGET_MS=40000
# Pause between eth_getLogs calls, in ms (keeps a free-tier key under its compute-units-per-second cap).
INDEXER_PAUSE_MS=150

# Vercel sets this header on cron calls when the variable exists; /api/sync requires it when set.
CRON_SECRET=
# Signing key of the Alchemy webhook that posts to /api/webhook (optional; unset = webhook disabled).
ALCHEMY_WEBHOOK_SIGNING_KEY=
